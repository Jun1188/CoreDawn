<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- SCR-04 인벤토리 · 수동 제작.

         패널을 화면 하단에 붙여 핫바가 HUD의 핫바와 같은 자리에 오게 한다 —
         I로 열고 닫아도 핫바는 움직이지 않는다. 위에서 아래로 제작 → 소지품 → 핫바.

         슬롯 격자·레시피 행·재료 줄은 개수가 데이터(컨테이너 크기·해금 레시피)에
         달려 있으므로 InventoryPanelView가 만든다. 여기에는 담을 자리만 둔다. -->
    <Style src="../Styles/tokens.uss" />
    <Style src="../Styles/components.uss" />
    <Style src="../Styles/screens.uss" />

    <ui:VisualElement name="screen-root" class="screen-root screen-root--bottom">
        <ui:VisualElement name="inv-panel" class="ui-panel inv-panel">

            <ui:VisualElement class="ui-panel__title">
                <ui:Label text="INV" class="ui-panel__tag" />
                <ui:Label text="인벤토리" />
                <ui:Button name="btn-close" text="✕" class="ui-panel__x" />
            </ui:VisualElement>

            <ui:VisualElement class="ui-panel__body inv-panel__body">

                <!-- 수동 제작 — 티어 0~1에서만 쓰는 기능이라 별도 화면을 주지 않는다 -->
                <ui:Label text="HAND CRAFT" class="inv-label inv-label--spaced" />
                <ui:VisualElement class="inv-craft">

                    <!-- 좌: 해금된 레시피만. 티어가 오르면 길어지므로 검색·스크롤 -->
                    <ui:VisualElement class="inv-craft__list">
                        <ui:VisualElement name="recipe-search-box" class="ui-search inv-craft__search">
                            <ui:TextField name="recipe-search" placeholder-text="레시피 검색" class="ui-search__input" />
                        </ui:VisualElement>
                        <ui:ScrollView name="recipes-scroll" class="ui-scroll inv-craft__scroll">
                            <ui:VisualElement name="recipes" />
                        </ui:ScrollView>
                        <ui:Label name="recipes-empty" text="해금된 레시피가 없습니다"
                                  class="inv-craft__empty ui-hidden" />
                    </ui:VisualElement>

                    <!-- 우: 선택한 레시피 상세 — 목록과 함께 봐야 고를 수 있어 가로 2단 -->
                    <ui:VisualElement name="detail" class="inv-craft__detail">
                        <ui:VisualElement class="ui-yield inv-craft__yield">
                            <ui:VisualElement class="ui-slot ui-slot--sm">
                                <ui:VisualElement name="yield-icon" class="ui-slot__icon" />
                            </ui:VisualElement>
                            <ui:VisualElement class="ui-fill">
                                <ui:Label name="yield-name" text="" class="inv-craft__yield-name" />
                                <ui:Label name="yield-per" text="" class="inv-craft__yield-per" />
                            </ui:VisualElement>
                            <ui:Label name="yield-time" text="" class="ui-timepill" />
                        </ui:VisualElement>

                        <!-- 재료는 스크롤하지 않는다 — 최대 4종(제조기 4입력)이 항상 다 보인다.
                             개수가 정해진 목록에 스크롤을 붙이면 "이게 전부인가"를 매번 확인하게 된다 -->
                        <ui:VisualElement name="mats" class="inv-craft__mats" />

                        <!-- 진행 표시는 버튼 하나에만 — 채움과 남은 시간이 한 덩어리로 읽힌다 -->
                        <ui:Button name="btn-craft" class="ui-btn ui-btn--primary ui-btn--hold inv-craft__btn">
                            <ui:VisualElement name="craft-btn-fill" class="ui-btn__fill" />
                            <ui:VisualElement class="ui-btn__label ui-btn__label--split">
                                <ui:Label name="craft-btn-text" text="누르고 있는 동안 제작" />
                                <ui:Label name="craft-btn-time" text="" class="ui-btn__time" />
                            </ui:VisualElement>
                        </ui:Button>
                    </ui:VisualElement>

                </ui:VisualElement>

                <!-- 소지품 — 빈 칸까지 전부 그린다. 칸 수가 곧 소지 한도다 -->
                <ui:VisualElement class="inv-section">
                    <ui:Label text="INVENTORY" class="inv-label" />
                    <ui:VisualElement name="grid" class="inv-grid" />
                </ui:VisualElement>

                <!-- 핫바 — HUD 핫바와 같은 자리. 격자에서 끌어 내리는 방향이 화면과 일치한다 -->
                <ui:VisualElement name="hotbar" class="inv-hotbar" />

            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
