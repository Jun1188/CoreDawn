/* 타이틀 화면 — Ref/TitleScreen/title.css 이식(2026-09-07).
 *
 * 레퍼런스의 홀로그램 패널은 clip-path(잘린 모서리)·box-shadow(글로우)·그라디언트인데 USS 에 셋 다 없다.
 * 그래서 .holo 요소는 배경·테두리를 비우고, C#(HoloBox, Painter2D)이 첫 자식으로 그려 넣는다.
 * 글리치 keyframes 도 C#(TitleGlitch) — 여기에는 그 오버레이(.glitch-fx__*)의 옷만 있다.
 * 색은 레퍼런스 값(--cyan #4fe8f0 계열)을 그대로 쓴다 — 게임 안 디자인 시스템(--copper)과 다른 화면이라 tokens 의 색 변수를 빌리지 않는다.
 * 폰트만 tokens.uss(--font-display/body/data)를 쓴다. 치수는 1920×1080 패널 기준. */

.title-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0);   /* 3D 카메라가 비쳐야 한다 */
    -unity-font-definition: var(--font-body);
    color: rgb(217, 251, 255);
}

/* ── 제목 · 버전 ─────────────────────────────────────────── */

.title-block {
    position: absolute;
    left: 120px;
    top: 72px;
    transition: opacity 0.4s;
}

.title-block--hidden {
    opacity: 0;
}

.title-block__name {
    margin: 0;
    padding: 0;
    -unity-font-definition: var(--font-display);
    font-size: 76px;
    letter-spacing: 3px;
    color: rgb(200, 251, 255);
    text-shadow: 0 0 18px rgba(79, 232, 240, 0.9);
}

.title-block__sub-row {
    flex-direction: row;
    align-items: center;
    margin-top: 12px;
}

.title-block__rule {
    width: 34px;
    height: 1px;
    margin-right: 12px;
    background-color: rgb(79, 232, 240);
}

.title-block__sub {
    -unity-font-definition: var(--font-data);
    font-size: 13px;
    letter-spacing: 3.5px;
    color: rgb(79, 232, 240);
    text-shadow: 0 0 8px rgba(79, 232, 240, 0.8);
}

.title-version {
    position: absolute;
    left: 120px;
    bottom: 26px;
    -unity-font-definition: var(--font-data);
    font-size: 13px;
    letter-spacing: 1.3px;
    color: rgba(79, 232, 240, 0.6);
}

/* ── 메뉴 컬럼 — 같은 자리를 번갈아 쓴다 ────────────────── */

.title-menu {
    position: absolute;
    left: 120px;
    top: 0;
    bottom: 0;
    justify-content: center;
    align-items: flex-start;
}

/* ── 홀로그램 요소 공통: 배경·테두리는 HoloBox 가 그린다 ─── */

.holo {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    overflow: visible;
}

.holo-btn {
    width: 340px;
    margin: 0 0 14px 0;
    padding: 17px 25px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    transition: translate 0.15s;
}

.holo-btn:hover {
    translate: 6px 0;
}

.holo-btn:active {
    background-color: rgba(0, 0, 0, 0);
}

.holo-btn__label {
    -unity-font-definition: var(--font-body);
    font-size: 22px;
    color: rgb(217, 251, 255);
    text-shadow: 0 0 8px rgba(79, 232, 240, 0.6);
    margin: 0;
    padding: 0;
}

.holo-btn__tag {
    position: absolute;
    right: 20px;
    top: 50%;
    translate: 0 -50%;
    -unity-font-definition: var(--font-display);
    font-size: 13px;
    letter-spacing: 2px;
    color: rgb(79, 232, 240);
    margin: 0;
    padding: 0;
}

.holo-btn--quit:hover .holo-btn__label {
    color: rgb(255, 228, 228);
    text-shadow: 0 0 8px rgba(255, 90, 90, 0.7);
}

.holo-btn--quit:hover .holo-btn__tag {
    color: rgb(255, 138, 138);
}

/* 발사 중 "게임 시작" 버튼 — 흐리게 두고 누르지 못한다 */
.holo-btn--launching {
    opacity: 0.35;
    transition: opacity 0.6s;
}

.holo-btn--disabled {
    opacity: 0.4;
}

.holo-btn--small {
    width: auto;
    flex-grow: 1;
    margin: 0 8px 0 0;
    padding: 11px 18px;
}

.holo-btn--small .holo-btn__label {
    font-size: 17px;
}

/* ── 패널(설정 · 불러오기) ───────────────────────────────── */

.holo-panel {
    width: 430px;
    padding: 20px 27px 18px 27px;
    flex-direction: column;
}

.holo-panel--load {
    width: 520px;
}

.holo-panel__h2 {
    -unity-font-definition: var(--font-display);
    font-size: 25px;
    letter-spacing: 2px;
    color: rgb(200, 251, 255);
    text-shadow: 0 0 8px rgba(79, 232, 240, 0.7);
    margin: 0;
    padding: 0;
}

.holo-panel__sec {
    flex-direction: row;
    align-items: center;
    margin-top: 16px;
}

.holo-panel__sec-label {
    -unity-font-definition: var(--font-data);
    font-size: 12px;
    letter-spacing: 3px;
    color: rgb(79, 232, 240);
    margin: 0;
    padding: 0;
}

.holo-panel__sec-rule {
    flex-grow: 1;
    height: 1px;
    margin-left: 10px;
    background-color: rgba(79, 232, 240, 0.4);
}

.holo-panel__btn {
    width: 100%;
    margin: 18px 0 0 0;
    padding: 12px 20px;
}

.holo-panel__btn .holo-btn__label {
    font-size: 18px;
}

.holo-panel__btn .holo-btn__tag {
    font-size: 12px;
}

.holo-panel__footer {
    flex-direction: row;
    margin-top: 14px;
}

/* 항목 한 줄: 왼쪽 이름, 오른쪽 조작부 */
.holo-row {
    flex-direction: row;
    align-items: center;
    margin-top: 9px;
}

.holo-row__label {
    width: 100px;
    flex-shrink: 0;
    font-size: 16px;
    color: rgb(169, 233, 238);
    margin: 0;
    padding: 0;
}

/* 조작부 공통 버튼(세그먼트·캐러셀 화살표) */
.holo-ctl {
    background-color: rgba(79, 232, 240, 0.08);
    border-width: 1px;
    border-color: rgba(79, 232, 240, 0.35);
    border-radius: 0;
    color: rgb(169, 233, 238);
    -unity-font-definition: var(--font-display);
    font-size: 13px;
    letter-spacing: 1px;
    margin: 0;
    padding: 6px 0;
}

.holo-ctl:hover {
    border-color: rgb(79, 232, 240);
}

.holo-ctl:disabled {
    opacity: 0.3;
}

/* 네온 바 0~10 */
.holo-bar {
    flex-grow: 1;
    flex-direction: row;
}

.holo-bar__cell {
    flex-grow: 1;
    height: 13px;
    margin-right: 3px;
    background-color: rgba(79, 232, 240, 0.15);
    border-width: 1px;
    border-color: rgba(79, 232, 240, 0.3);
    transition: background-color 0.1s;
}

.holo-bar__cell--on {
    background-color: rgb(79, 232, 240);
    border-color: rgb(79, 232, 240);
}

/* 세그먼트 */
.holo-seg {
    flex-grow: 1;
    flex-direction: row;
}

.holo-seg__opt {
    flex-grow: 1;
    margin-right: 4px;
}

.holo-seg__opt--on {
    background-color: rgba(79, 232, 240, 0.3);
    color: rgb(255, 255, 255);
    border-color: rgb(79, 232, 240);
}

/* 캐러셀 ◀ 값 ▶ */
.holo-car {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
}

.holo-car__arrow {
    width: 32px;
    flex-shrink: 0;
    font-size: 11px;
    color: rgb(79, 232, 240);
    padding: 7px 0;
}

.holo-car__arrow:hover {
    background-color: rgba(79, 232, 240, 0.25);
}

.holo-car__value {
    flex-grow: 1;
    margin: 0 4px;
    padding: 6px 0;
    -unity-font-definition: var(--font-display);
    font-size: 13px;
    letter-spacing: 1px;
    color: rgb(255, 255, 255);
    background-color: rgba(79, 232, 240, 0.3);
    border-width: 1px;
    border-color: rgb(79, 232, 240);
    -unity-text-align: middle-center;
}

/* 슬롯 목록(saveload.uss) — 홀로 패널 안에서는 높이만 제한 */
.title-slots {
    max-height: 380px;
    margin-top: 10px;
}

/* ── 로딩 · 페이드 ───────────────────────────────────────── */

/* 로딩 상자(레퍼런스 .load-box) — Boot 씬(BootScreen.uxml)과 타이틀 오버레이가 같이 쓴다 */
.load-screen {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgb(7, 13, 26);
    justify-content: center;
    align-items: center;
}

.load-box {
    width: 380px;
}

.load-row {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 12px;
}

.load-row__text {
    -unity-font-definition: var(--font-display);
    font-size: 15px;
    letter-spacing: 4.5px;
    color: rgb(79, 232, 240);
    text-shadow: 0 0 8px rgba(79, 232, 240, 0.7);
    margin: 0;
    padding: 0;
}

/* 바 자체는 HoloBar(Painter2D) — 기울어진 양끝·글로우 */
.load-bar {
    height: 7px;
    margin-bottom: 12px;
}

.load-msg {
    -unity-font-definition: var(--font-data);
    font-size: 12px;
    letter-spacing: 2.5px;
    color: rgba(79, 232, 240, 0.6);
    margin: 0;
    padding: 0;
}

.load-msg--error {
    color: rgb(255, 90, 90);
}

.title-loading {
    transition: opacity 0.5s;
}

.title-loading--hide {
    opacity: 0;
}

.title-fade {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgb(7, 13, 26);
    opacity: 0;
}

/* ── 글리치 오버레이(TitleGlitch 가 만든다) ──────────────── */

.glitch-fx {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    display: none;
}

.glitch-fx__layer {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.glitch-fx__mask {
    position: absolute;
    left: -8px;
    right: -8px;
    background-color: rgba(7, 13, 26, 0.94);
}

.glitch-fx__bright {
    background-color: rgb(180, 250, 255);
    opacity: 0;
}
