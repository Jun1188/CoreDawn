<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Scripts/Runtime/UI/Styles/tokens.uss?fileID=7433441132597879392&amp;guid=9db750b513ab8d340b5033a21edc4083&amp;type=3#tokens"/>
    <Style src="project://database/Assets/Scripts/Runtime/UI/Styles/components.uss?fileID=7433441132597879392&amp;guid=f1501a2a6100e3e4a982c5a6596ab3f9&amp;type=3#components"/>
    <Style src="project://database/Assets/Scripts/Runtime/UI/Styles/screens.uss?fileID=7433441132597879392&amp;guid=9ba5f258d5c533f4bbe056cb3b46ca4a&amp;type=3#screens"/>
    <ui:VisualElement name="hud" class="hud-root">
        <ui:VisualElement class="combat-top">
            <ui:VisualElement name="compass" class="ui-compass combat-compass">
                <ui:VisualElement class="ui-compass__center"/>
            </ui:VisualElement>
            <ui:VisualElement name="enemy-line" class="combat-enemyline">
                <ui:Label name="enemy-count" text="0" class="combat-enemyline__n"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement class="combat-stats">
            <ui:VisualElement class="ui-stat">
                <ui:Label text="DAY" class="ui-stat__label"/>
                <ui:Label name="day-value" text="—" class="ui-stat__value"/>
            </ui:VisualElement>
            <ui:VisualElement class="ui-stat">
                <ui:Label name="phase-label" text="NIGHT IN" class="ui-stat__label"/>
                <ui:Label name="phase-time" text="—" class="ui-stat__value"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="crosshair" class="combat-cross">
            <ui:VisualElement class="combat-cross__bar combat-cross__bar--n"/>
            <ui:VisualElement class="combat-cross__bar combat-cross__bar--s"/>
            <ui:VisualElement class="combat-cross__bar combat-cross__bar--w"/>
            <ui:VisualElement class="combat-cross__bar combat-cross__bar--e"/>
        </ui:VisualElement>
        <ui:Label name="interact-prompt" text="" picking-mode="Ignore" class="combat-interact"/>
        <ui:VisualElement name="death-overlay" picking-mode="Ignore" class="combat-death">
            <ui:Label text="You Die" picking-mode="Ignore" class="combat-death__text"/>
        </ui:VisualElement>
        <ui:VisualElement class="combat-vitals">
            <ui:VisualElement class="combat-vitals__head">
                <ui:Label name="hp-now" text="—" class="combat-vitals__hp"/>
                <ui:Label name="hp-max" text="" class="combat-vitals__max"/>
                <ui:Label text="VITALS" class="combat-vitals__tag"/>
            </ui:VisualElement>
            <ui:VisualElement class="combat-vitals__bar">
                <ui:VisualElement name="hp-fill" class="combat-vitals__fill"/>
            </ui:VisualElement>
            <ui:VisualElement name="core-line" class="combat-core">
                <ui:Label text="CORE" class="combat-core__tag"/>
                <ui:VisualElement class="combat-core__bar">
                    <ui:VisualElement name="core-fill" class="combat-core__fill"/>
                </ui:VisualElement>
                <ui:Label name="core-pct" text="—" class="combat-core__n"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="ammo" class="combat-ammo">
            <ui:Label name="ammo-name" text="" class="ui-stat__label"/>
            <ui:VisualElement class="combat-ammo__row">
                <ui:Label name="ammo-now" text="" class="combat-ammo__now"/>
                <ui:Label name="ammo-cap" text="" class="combat-ammo__cap"/>
            </ui:VisualElement>
            <ui:VisualElement class="combat-ammo__typeline">
                <ui:Label name="ammo-type" text="" class="combat-ammo__type"/>
                <ui:Label name="ammo-reserve" text="" class="combat-ammo__reserve"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="hotbar" class="combat-hotbar"/>
        <ui:Label
    name="hit-marker"
    text="×"
    style="
        position: absolute;
        left: 50%;
        top: 50%;
        translate: -50% -50%;
        color: rgb(255, 0, 0);
        font-size: 18px;
        -unity-font-style: bold;
        unity-text-align: middle-center;
    "
/>
    </ui:VisualElement>
</ui:UXML>
