<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- SCR-01 코어 패널 — 납품 탭.
         정적 뼈대만 여기 둔다. 요구 부품 행과 수리 단계는 개수가 데이터에 달려
         있으므로 CorePanelView가 만든다. 인라인 style은 쓰지 않는다 (문서 §05) —
         런타임 값인 진행바 width만 예외로 코드에서 설정한다. -->
    <Style src="../Styles/tokens.uss" />
    <Style src="../Styles/components.uss" />
    <Style src="../Styles/screens.uss" />

    <ui:VisualElement name="screen-root" class="screen-root">
        <ui:VisualElement name="core-panel" class="ui-panel core-panel">

            <!-- 제목줄: 태그(영문 계통) + 이름(한글) + ✕ -->
            <ui:VisualElement class="ui-panel__title">
                <ui:Label text="CORE" class="ui-panel__tag" />
                <ui:Label text="코어" />
                <ui:Button name="btn-close" text="✕" class="ui-panel__x" />
            </ui:VisualElement>

            <ui:VisualElement class="ui-tabs core-panel__tabs">
                <ui:Button name="tab-deliver" text="납품" class="ui-tab ui-tab--active" />
                <ui:Button name="tab-info" text="코어 정보" class="ui-tab" />
            </ui:VisualElement>

            <ui:VisualElement class="ui-panel__body">
            <ui:VisualElement name="view-deliver" class="core-panel__body">

                <!-- 좌: 수리 단계 레일. 되돌릴 수 없는 일방향 진행 -->
                <ui:VisualElement name="rail" class="ui-rail core-panel__rail" />

                <!-- 우: 납품 -->
                <ui:VisualElement class="ui-fill">

                    <!-- 게이트 전체 진행 — "얼마나 찼는가"에 답한다 -->
                    <ui:VisualElement name="gate" class="core-gate">
                        <ui:VisualElement class="core-gate__head">
                            <ui:Label name="gate-name" text="" class="core-gate__name" />
                            <ui:Label name="gate-count" text="" class="core-gate__count" />
                        </ui:VisualElement>
                        <ui:VisualElement class="core-gate__meter">
                            <ui:VisualElement class="ui-bar ui-bar--thick ui-bar--crystal">
                                <ui:VisualElement name="gate-fill" class="ui-bar__fill" />
                            </ui:VisualElement>
                            <ui:Label name="gate-pct" text="0%" class="ui-num core-gate__pct" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- 아래 표 — "어느 부품이 모자란가"에 답한다.
                         둘은 다른 질문이라 같이 둔다 (문서 SCR-01) -->
                    <!-- 머리글은 고정, 행만 스크롤 — 부품이 늘어도 창 크기는 그대로다 -->
                    <ui:VisualElement name="table" class="ui-table">
                        <ui:VisualElement class="ui-table__head">
                            <ui:Label text="부품" class="ui-col-part" />
                            <ui:Label text="납품 진행" class="ui-col-bar" />
                            <ui:Label text="보유" class="ui-col-num" />
                            <ui:Label text="부족" class="ui-col-num" />
                            <ui:Label text="이번 납품" class="ui-col-act" />
                        </ui:VisualElement>
                        <ui:ScrollView name="rows-scroll" class="ui-scroll core-rows-scroll">
                            <ui:VisualElement name="rows" />
                        </ui:ScrollView>
                    </ui:VisualElement>

                    <!-- 최고 티어 도달 시 표 대신 보여준다 -->
                    <ui:VisualElement name="complete" class="core-complete ui-hidden">
                        <ui:Label text="모든 수리 단계를 마쳤습니다" class="core-complete__title" />
                        <ui:Label text="더 납품할 부품이 없습니다." class="core-complete__desc" />
                    </ui:VisualElement>

                    <ui:VisualElement name="actions" class="core-actions">
                        <ui:Label name="actions-label" text="이번에 납품" class="core-actions__label" />
                        <ui:VisualElement name="actions-chips" class="ui-row-flex" />
                        <ui:Button name="btn-all" class="ui-btn ui-btn--ghost ui-push">
                            <ui:Label text="전부 선택" />
                            <ui:Label text="A" class="ui-btn__key" />
                        </ui:Button>
                        <ui:Button name="btn-deliver" class="ui-btn ui-btn--primary">
                            <ui:Label name="btn-deliver-label" text="납품" />
                            <ui:Label text="F" class="ui-btn__key" />
                        </ui:Button>
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:VisualElement>

            <!-- SCR-01c 코어 정보 탭.
                 WAVE 구획과 레이더 표시는 뒷단 시스템이 없어 CoreInfoDummyData로 채워진다.
                 진짜 값은 코어 내구도와 수리 진행 둘뿐이다. -->
            <ui:VisualElement name="view-info" class="core-panel__body ui-hidden">

                <ui:VisualElement class="ui-fill">
                    <ui:Label text="CORE STATUS" class="core-section-label" />

                    <ui:VisualElement class="core-stat">
                        <ui:VisualElement class="core-stat__head">
                            <ui:Label text="코어 내구도" class="core-stat__name" />
                            <!-- 현재값은 본색, "/ 최대"는 흐리게 — 설계 SCR-01c -->
                            <ui:VisualElement class="core-stat__value">
                                <ui:Label name="hp-text" text="—" class="ui-num" />
                                <ui:Label name="hp-max" text="" class="ui-num ui-num--dim" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="ui-bar ui-bar--thick ui-bar--ok">
                            <ui:VisualElement name="hp-fill" class="ui-bar__fill" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:VisualElement class="core-stat">
                        <ui:VisualElement class="core-stat__head">
                            <ui:Label text="수리 진행" class="core-stat__name" />
                            <ui:VisualElement class="core-stat__value">
                                <ui:Label name="repair-text" text="—" class="ui-num" />
                                <ui:Label name="repair-max" text="" class="ui-num ui-num--dim" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:VisualElement class="ui-bar ui-bar--thick ui-bar--crystal">
                            <ui:VisualElement name="repair-fill" class="ui-bar__fill" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- WAVE — 전부 더미 (CoreInfoDummyData). 웨이브 시스템 붙으면 교체 -->
                    <ui:Label text="WAVE" class="core-section-label core-section-label--spaced" />
                    <ui:VisualElement class="core-wave">
                        <ui:VisualElement class="ui-stat core-wave__item">
                            <ui:Label text="NEXT WAVE IN" class="ui-stat__label" />
                            <ui:Label name="wave-next" text="—" class="ui-stat__value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="ui-stat core-wave__item">
                            <ui:Label text="WAVE" class="ui-stat__label" />
                            <ui:Label name="wave-number" text="—" class="ui-stat__value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="ui-stat core-wave__item">
                            <ui:Label text="INCOMING" class="ui-stat__label" />
                            <ui:Label name="wave-incoming" text="—" class="ui-stat__value core-wave__danger" />
                        </ui:VisualElement>
                        <ui:VisualElement class="ui-stat core-wave__item">
                            <ui:Label text="DESTROYED NESTS" class="ui-stat__label" />
                            <ui:Label name="wave-nests" text="—" class="ui-stat__value" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- 레이더 스코프. 해금 전이면 격자만 남기고 데이터를 비운다 (SCR-01d) -->
                <ui:VisualElement class="core-info__radar">
                    <ui:VisualElement class="core-section-row">
                        <ui:Label text="RADAR" class="core-section-label core-section-label--inline" />
                        <ui:VisualElement name="radar-chip" class="ui-chip ui-push">
                            <ui:Label name="radar-chip-text" text="신호 없음" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <!-- RadarScope는 Painter2D로 그리므로 코드에서 붙인다 (UXML 요소가 아님) -->
                    <ui:VisualElement name="radar-slot" class="core-radar-slot" />
                </ui:VisualElement>

            </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
