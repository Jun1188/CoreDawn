/* ═══════════════════════════════════════════════════════════════════════
   screens.uss — 화면별 예외만. 여기 규칙이 늘어나면 components.uss로
   승격할 후보라는 뜻이다 (부품으로 조립되지 않는 화면이 생기고 있다는 신호).
   ═══════════════════════════════════════════════════════════════════════ */

/* 팝업 루트 — UIDocument 최상단. 화면 전체를 덮고 패널만 가운데 띄운다 */
.screen-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 10, 20, 0.55);
}

/* ───────────────── SCR-03 건설 메뉴 ───────────────── */

/* 코어 패널과 같은 규칙 — 크기 고정, 넘치면 스크롤 */
.build-panel {
    width: 620px;
    height: 500px;
}

.build-panel__body {
    padding-top: 0;
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.build-grid-scroll {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

/* 탭이 패널 안쪽 여백을 넘어 양끝까지 닿게 한다 */
.build-panel__tabs {
    margin-left: -16px;
    margin-right: -16px;
    padding-left: var(--space-4);
    padding-right: var(--space-4);
    margin-bottom: var(--space-4);
}

/* 2열. USS에 grid가 없으므로 50% 셀을 flex-wrap으로 흘린다 */
.build-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.build-cell {
    width: 50%;
    padding-right: var(--space-1);
    padding-bottom: var(--space-2);
}

/* 셀이 폭을 정하므로 행의 최소폭 규칙은 여기서 푼다 */
.build-cell .ui-row { min-width: 0; }

.build-empty {
    font-size: var(--fs-cap);
    color: var(--text-faint);
    padding: var(--space-5) 0;
    -unity-text-align: middle-center;
}

/* 하단 상세 — 높이 고정. 설명 길이에 따라 창이 흔들리면 안 된다.
   설명이 두 줄인 건물(분배기 등)까지 담기게 잡고, 아래 여백을 둬서
   비용 칩이 경계에 딱 붙지 않게 한다. */
/* 높이 고정 — 커서를 옮길 때마다 상세 영역이 늘었다 줄면 아래 목록이 출렁여 고르기 어렵다.
   최악(재료 4종 · 설명 2줄)이 들어가는 높이로 잡는다. */
.build-details {
    height: 168px;
    flex-shrink: 0;
    margin-top: var(--space-3);
    padding-top: var(--space-3);
    padding-bottom: var(--space-3);
    border-top-width: 1px;
    border-top-color: var(--line);
    overflow: hidden;
}

.build-details__head {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-2);
}

.build-details__name {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--copper);
    margin-right: var(--space-3);
}

.build-details__type {
    font-size: 10px;
    letter-spacing: 1.2px;
    color: var(--text-faint);
}

.build-details__desc {
    font-size: var(--fs-cap);
    color: var(--text-dim);
    white-space: normal;
    margin-bottom: var(--space-2);
}

.build-details__meta {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-right: -8px;
}

.build-details__meta > * { margin-right: var(--space-2); }

.build-details__size {
    font-size: var(--fs-cap);
    color: var(--text-dim);
}

.build-details__cost-label {
    font-size: 11px;
    color: var(--text-faint);
}

/* 이제 독립된 줄이다 — 라벨과 같은 줄에 있던 시절의 wrap 은 필요 없다 */
.build-details__cost {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: var(--space-2);
    margin-right: -8px;
}

.build-details__cost > * { margin-right: var(--space-2); }

/* 커서를 아무 데도 올리지 않았을 때 자리를 지키는 안내 */
.build-details__empty {
    font-size: var(--fs-cap);
    color: var(--text-faint);
}

.build-hints {
    flex-direction: row;
    align-items: center;
    margin-left: auto;
    margin-right: -12px;
}

.build-hints > * { margin-right: var(--space-3); }

/* ───────────────── SCR-01 코어 패널 ───────────────── */

/* 크기는 고정. 부품이 몇 종이든 창이 커졌다 작아졌다 하면 안 된다 —
   넘치는 것은 스크롤로 처리한다. */
.core-panel {
    width: 880px;
    height: 520px;
}

.core-panel__tabs { padding: 0 var(--space-4); }

/* 제목·탭은 고정 높이, 본문이 남은 공간을 먹는다 */
.core-panel > .ui-panel__body {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    overflow: hidden;
}

.core-panel__body {
    flex-direction: row;
    align-items: stretch;
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.core-panel__rail {
    width: 176px;
    flex-shrink: 0;
    margin-right: var(--space-5);
}

/* 표: 머리글은 제자리, 행 영역만 남은 높이를 먹고 스크롤한다 */
.core-panel__body .ui-table {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.core-rows-scroll {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

/* 값과 "/ 최대"를 한 줄에 붙인다 */
.core-stat__value {
    flex-direction: row;
    align-items: center;
}

.core-stat__value > * { margin-left: 4px; }

/* 게이트 요약 — 이 게이트 전체가 얼마나 찼는지 */
.core-gate {
    margin-bottom: var(--space-4);
}

/* 문서 목업은 baseline 정렬이지만 USS의 align-items에는 baseline이 없다
   (auto/flex-start/flex-end/center/stretch만). 글자 크기가 다른 두 줄이라 flex-end가 가장 가깝다 */
.core-gate__head {
    flex-direction: row;
    align-items: flex-end;
    margin-bottom: var(--space-2);
}

.core-gate__name {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--text);
}

.core-gate__count {
    margin-left: auto;
    font-size: var(--fs-cap);
    color: var(--text-faint);
}

.core-gate__meter {
    flex-direction: row;
    align-items: center;
}

.core-gate__meter .ui-bar {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    margin-right: var(--space-3);
}

.core-gate__pct {
    width: 48px;
    color: var(--crystal);
    -unity-text-align: middle-right;
}

/* 하단 액션 줄 — "이번에 납품" 요약 + 버튼 */
.core-actions {
    flex-direction: row;
    align-items: center;
    margin-top: var(--space-4);
    padding-top: var(--space-3);
    border-top-width: 1px;
    border-top-color: var(--line);
}

.core-actions > * { margin-right: var(--space-3); }

.core-actions__label {
    font-size: 12px;
    color: var(--text-faint);
}

/* 모든 부품이 준비됐을 때 나오는 줄 */
.core-actions__ready {
    font-size: 13px;
    color: var(--ok);
}

/* 준비 상태의 확정 버튼 — 이 줄에서 유일한 행동이므로 좌우를 넉넉히 준다.
   `.core-actions > *`의 오른쪽 여백을 확실히 이기도록 같은 자식 선택자로 쓴다
   (같은 특정도면 순서로 갈리는데, 그런 건 나중에 규칙이 하나 끼어들면 조용히 뒤집힌다) */
.core-actions > .core-actions__go {
    padding-left: var(--space-5);
    padding-right: var(--space-5);
    margin-right: 0;
}

/* ───────────── SCR-01c 코어 정보 탭 ───────────── */

.core-section-label {
    font-size: 10px;
    letter-spacing: 1.2px;
    color: var(--text-faint);
    margin-bottom: var(--space-3);
}

.core-section-label--inline { margin-bottom: 0; }
.core-section-label--spaced { margin-top: var(--space-4); }

/* 웨이브 수치 — 라벨 위, 값 아래 (ui-stat). 한 줄에 넉넉히 벌린다 */
.core-wave {
    flex-direction: row;
    flex-wrap: wrap;
}

.core-wave__item {
    margin-right: var(--space-5);
    margin-bottom: var(--space-2);
}

.core-wave__danger { color: var(--beast); }

/* 레이더가 꺼져 있어 모르는 값 — 색으로 강조하지 않는다 */
.core-wave__unknown { color: var(--text-faint); }

/* 레이더 스코프가 들어갈 자리 — 탭에 남는 세로 공간을 전부 먹는다.
   스코프 반지름은 이 상자 크기에서 계산되므로 상자가 커지면 스코프도 커진다. */
.core-radar-slot {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
    background-color: var(--bg-inset);
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: var(--r-md);
    padding: var(--space-3);
}

.core-section-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-3);
}

.core-stat { margin-bottom: var(--space-3); }

.core-stat__head {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 5px;
}

.core-stat__name {
    font-size: var(--fs-cap);
    color: var(--text-dim);
}

/* 설계 viewBox(440x300) 폭에 맞춘다 — 좌우 지시선 라벨 자리를 여기서 확보한다 */
.core-info__radar {
    width: 440px;
    flex-shrink: 0;
    margin-left: var(--space-5);
}

/* 최고 티어 도달 — 더 납품할 것이 없을 때 표 자리를 대신한다 */
.core-complete {
    padding: var(--space-6) var(--space-4);
    align-items: center;
}

.core-complete__title {
    font-size: var(--fs-sub);
    color: var(--ok);
    margin-bottom: var(--space-2);
}

.core-complete__desc {
    font-size: var(--fs-cap);
    color: var(--text-faint);
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ═══════════════════════════════════════════════════════════════════════
   SCR-05 배치 모드 HUD · SCR-06 철거 모드 HUD
   ═══════════════════════════════════════════════════════════════════════ */

/* HUD는 화면을 덮지 않는다 — 루트는 전면을 차지하되 아무것도 그리지 않고,
   실제 요소만 위/아래에 띄운다. picking은 UXML에서 전부 Ignore로 꺼 두었다
   (여기로 클릭이 먹히면 월드 배치가 막힌다). */
.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    -unity-font-definition: var(--font-body);
    /* 배경을 깔지 않는다 — .screen-root의 스크림은 모달 전용이다.
       HUD는 월드를 가리면 안 되므로 완전히 투명하게 둔다. */
}

.hud-badge {
    position: absolute;
    top: 16px;
    left: 0;
    right: 0;
    align-items: center;
}

.hud-card-slot {
    position: absolute;
    bottom: 24px;
    left: 0;
    right: 0;
    align-items: center;
}

/* 카드 안 요소들 — USS에 gap이 없어 개별 margin으로 띄운다 */
.hud-card__icon {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    margin-right: var(--space-3);
}

.hud-card__ring {
    margin-right: var(--space-3);
}

.hud-card__title {
    flex-direction: column;
    justify-content: center;
}

.hud-card__cost {
    flex-direction: row;
    align-items: center;
}

.hud-card__keys {
    flex-direction: row;
    align-items: center;
}

/* 카드 안에서는 마지막 칩/키의 오른쪽 여백을 지운다 —
   USS에 :last-child가 없어 뷰가 --last 클래스를 붙인다 */
.hud-card__cost > .ui-chip { margin-right: var(--space-2); }
.hud-card__keys > .ui-key  { margin-right: var(--space-3); }
.hud-card__cost > .ui-chip--last { margin-right: 0; }
.hud-card__keys > .ui-key--last  { margin-right: 0; }

/* ═══════════════════════════════════════════════════════════════════════
   SCR-01b 수리 확인창
   ═══════════════════════════════════════════════════════════════════════ */

/* 코어 패널 위에 겹쳐 뜬다 — 뒤 화면을 덮어 지금 답해야 할 질문 하나만 남긴다 */
.core-confirm-scrim {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(6, 10, 20, 0.55);
}

.core-confirm {
    width: 460px;
}

.core-confirm__desc {
    font-size: 13px;
    color: var(--text);
    white-space: normal;
    margin-bottom: var(--space-4);
}

.core-confirm__unlocks {
    flex-direction: column;
    margin-bottom: var(--space-4);
}

.core-confirm__unlocks > .ui-mat { margin-bottom: 2px; }

/* 되돌릴 수 없는 단계에만 붙는다. 전부에 붙이면 정작 위험한 마지막에서 눈에 안 띈다 */
.core-confirm__warn {
    border-width: 1px;
    border-color: var(--danger-a50);
    background-color: var(--danger-a07);
    border-radius: var(--r-md);
    padding: var(--space-3);
    margin-bottom: var(--space-4);
}

.core-confirm__warn-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-2);
}

.core-confirm__warn-icon {
    color: var(--danger);
    font-size: 13px;
    margin-right: var(--space-2);
}

.core-confirm__warn-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: var(--danger);
}

.core-confirm__warn-body {
    font-size: 12px;
    color: var(--text-dim);
    white-space: normal;
}

/* 확인 버튼을 조금 넓게 — 기본 행동이 어느 쪽인지 크기로 말한다 */
.core-confirm__actions {
    flex-direction: row;
}

.core-confirm__cancel {
    flex-grow: 1;
    flex-basis: 0;
    justify-content: center;
    margin-right: var(--space-2);
}

.core-confirm__ok {
    flex-grow: 1.4;
    flex-basis: 0;
    justify-content: center;
}

/* ═══════════════════════════════════════════════════════════════════════
   SCR-07 분배기 — 출구 필터
   ═══════════════════════════════════════════════════════════════════════ */

.splitter-panel {
    width: 660px;
    height: 420px;
}

/* 문서는 grid(250px + 1fr)지만 USS에 grid가 없어 flex로 같은 결과를 만든다 */
.splitter-panel__body {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.splitter-map-col {
    width: 250px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin-right: var(--space-5);
}

.splitter-list-col {
    flex-grow: 1;
    flex-basis: 0;
    min-width: 0;
    height: 100%;
}

.splitter-list__head {
    flex-direction: row;
    align-items: center;
    margin-bottom: var(--space-3);
}

/* 선택한 출구의 색 — 목록이 어느 출구의 것인지 색으로 먼저 말한다 */
.splitter-list__swatch {
    width: 14px;
    height: 14px;
    border-radius: 3px;
    background-color: var(--out);
    margin-right: var(--space-2);
}

/* 제목이 남은 폭을 먹어 버튼들을 오른쪽 끝으로 민다.
   .ui-push(margin-left:auto)를 버튼에 걸면 아래 .splitter-list__btn의
   margin-left가 그것을 덮어써서(같은 프로퍼티, 나중 규칙) 밀리지 않는다. */
.splitter-list__title {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--text);
    flex-grow: 1;
    flex-basis: 0;
    overflow: hidden;
}

.splitter-list__btn {
    padding: 3px 10px;
    font-size: 12px;
    margin-left: 6px;
    flex-shrink: 0;
}

.splitter-list__search { margin-bottom: var(--space-2); }

.splitter-list__scroll {
    flex-grow: 1;
    flex-basis: 0;
    min-height: 0;
}

.splitter-list__empty {
    font-size: var(--fs-cap);
    color: var(--text-faint);
    padding: var(--space-4) 0;
    -unity-text-align: middle-center;
}

/* 규칙을 한 줄로 다시 말해 준다 — 막은 출구를 만들고 나면 가장 먼저 드는 의문이다 */
.splitter-list__foot {
    margin-top: auto;
    padding-top: var(--space-3);
    border-top-width: 1px;
    border-top-color: var(--line);
    font-size: 11px;
    color: var(--text-faint);
}
