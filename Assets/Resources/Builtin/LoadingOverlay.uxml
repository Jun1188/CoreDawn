<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <!-- 씬 전환 오버레이(AppFlow) — 타이틀 레퍼런스 Ref/TitleScreen/title.html 의 #load 와 같은 상자. 스타일은 title.uss 의 .load-* 공유.
         바(load-bar)에는 AppFlow 가 HoloBar(Painter2D)를 끼운다. Resources 에 두는 이유: AppFlow 는 씬 없이 코드로 생기기 때문. -->
    <Style src="/Assets/Scripts/Presentation/UI/Styles/tokens.uss" />
    <Style src="/Assets/Scripts/Presentation/UI/Styles/title.uss" />
    <ui:VisualElement name="load-screen" class="load-screen">
        <ui:VisualElement class="load-box">
            <ui:VisualElement class="load-row">
                <ui:Label name="load-title" text="WARPING TO STAR SYSTEM" class="load-row__text" />
                <ui:Label name="load-pct" text="0%" class="load-row__text" />
            </ui:VisualElement>
            <ui:VisualElement name="load-bar" class="load-bar" />
            <ui:Label name="load-msg" text="INIT" class="load-msg" />
        </ui:VisualElement>
        <!-- 컷신(mp4 → RenderTexture) — CutscenePlayer 가 배경 이미지로 끼우고 켠다. 검정 위에 비율 유지로 맞춘다. -->
        <ui:VisualElement name="cutscene" class="cutscene" style="display: none;">
            <ui:VisualElement name="cutscene-skip" class="cutscene-skip">
                <ui:Label text="HOLD ESC TO SKIP" class="cutscene-skip__text" />
                <ui:VisualElement class="cutscene-skip__track"><ui:VisualElement name="cutscene-skip-fill" class="cutscene-skip__fill" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
